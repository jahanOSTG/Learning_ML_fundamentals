        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "x = np.arange(11)\n",
        "\n",
        "plt.plot(x, x + 2, label=\"x+2\", color='blue')\n",
        "\n",
        "plt.plot(x, x + 3, label=\"x+3\", color='orange')\n",
        "\n",
        "plt.legend(loc='lower right')\n",
        "\n",
        "plt.show()\n"
      ]
